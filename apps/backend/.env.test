# Environment for `npm run test:integration:http`.
#
# @medusajs/test-utils does NOT read DATABASE_URL. It assembles its own
# connection string from these parts and creates a throwaway database per run,
# so the DB_* variables below are the ones that matter. Getting them wrong
# surfaces as "SASL: SCRAM-SERVER-FIRST-MESSAGE: client password must be a
# string", which points nowhere near the real cause.
#
# These defaults match a local Postgres started with:
#   docker run --rm -p 5432:5432 \
#     -e POSTGRES_USER=medusa -e POSTGRES_PASSWORD=medusa \
#     -e POSTGRES_DB=medusa_test postgres:16-alpine
#
# The user needs CREATEDB, because each run creates and drops its own database.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medusa
DB_PASSWORD=medusa

# medusa-config.ts still needs a valid-looking URL to load.
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_test

JWT_SECRET=test-secret
COOKIE_SECRET=test-secret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
