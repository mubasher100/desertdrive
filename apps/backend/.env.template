# =============================================================================
# Desert Drive — backend environment
#
# Copy to `.env` for local development. In production these are Railway variables.
# `.env` is gitignored; THIS file is committed and documents every variable.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → **Session pooler**.
#
#   ✅ Session pooler,     port 5432  — IPv4, prepared statements survive. USE THIS.
#   ❌ Direct connection,  port 5432  — IPv6-only, often unreachable from Railway.
#   ❌ Transaction pooler, port 6543  — breaks MikroORM migrations and throws
#                                       `prepared statement "s1" does not exist`
#                                       intermittently under load.
#
# Do NOT append ?sslmode=require — node-postgres reads it as verify-full and
# rejects Supabase's chain with SELF_SIGNED_CERT_IN_CHAIN. TLS is configured in
# medusa-config.ts via databaseDriverOptions.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Redis ------------------------------------------------------------------
# Railway Redis PRIVATE url (redis.railway.internal), so it never leaves the
# private network. Drives cache, event bus, workflow engine and locking.
# Railway does not shell-expand $VAR in a start command — if you set a Redis
# password, write it out literally.
REDIS_URL=redis://localhost:6379

# --- Secrets ----------------------------------------------------------------
# Generate real values: openssl rand -base64 32
# The backend refuses to boot in production if these are still "supersecret".
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# HMAC secret for the signed booking-lookup link in the confirmation email.
# A booking holds a phone number, a flight number and a home address, so this is
# the only thing standing between a guessed order id and someone's travel plans.
# Set the SAME value on the storefront (it verifies what this signs).
BOOKING_TOKEN_SECRET=

# --- CORS -------------------------------------------------------------------
# Three separate lists. Adding a storefront origin means updating STORE_CORS
# *and* AUTH_CORS — forgetting AUTH_CORS is the classic one.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# --- Runtime ----------------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
# shared | server | worker. `shared` runs API + worker in one process.
MEDUSA_WORKER_MODE=shared

# --- Fare geometry ----------------------------------------------------------
# Hamad International Airport. EVERY fare in the system keys off this one point,
# because the distance band is resolved as straight-line km from here.
# Verify before trusting: a few hundred metres of error moves band boundaries.
AIRPORT_LAT=25.273056
AIRPORT_LNG=51.608056

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender on the Resend domain.
RESEND_FROM_EMAIL=bookings@desertdrive.qa

# --- Payments (SkipCash) ----------------------------------------------------
# Sandbox:    https://skipcashtest.azurewebsites.net
# Production: https://api.skipcash.app
# All from the merchant portal → Sandbox/Production → Credentials. Leave
# SKIPCASH_KEY_SECRET empty and the provider is not registered at all (cash
# only) — useful on a dev machine.
#
# In the portal, set:
#   Webhook URL = <MEDUSA_BACKEND_URL>/hooks/payment/skipcash_skipcash
#   Return URL  = <storefront>/en-qa/payment/return   (the storefront overrides
#                 this per payment; the portal value is only a fallback)
SKIPCASH_BASE_URL=https://skipcashtest.azurewebsites.net
SKIPCASH_CLIENT_ID=
SKIPCASH_KEY_ID=
SKIPCASH_KEY_SECRET=
SKIPCASH_WEBHOOK_KEY=

# --- Escape hatches ---------------------------------------------------------
# `medusa start` forces NODE_ENV=production even locally, which trips the Redis
# guard. Set this ONLY to run a production build on a dev machine.
# NEVER set it on Railway.
# ALLOW_INMEMORY_INFRA=true
