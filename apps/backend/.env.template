# =============================================================================
# Desert Drive — backend environment
#
# Copy to `.env` for local development. In production these are Railway variables.
# `.env` is gitignored; THIS file is committed and documents every variable.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → **Session pooler**.
#
#   ✅ Session pooler,     port 5432  — IPv4, prepared statements survive. USE THIS.
#   ❌ Direct connection,  port 5432  — IPv6-only, often unreachable from Railway.
#   ❌ Transaction pooler, port 6543  — breaks MikroORM migrations and throws
#                                       `prepared statement "s1" does not exist`
#                                       intermittently under load.
#
# Do NOT append ?sslmode=require — node-postgres reads it as verify-full and
# rejects Supabase's chain with SELF_SIGNED_CERT_IN_CHAIN. TLS is configured in
# medusa-config.ts via databaseDriverOptions.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Redis ------------------------------------------------------------------
# Railway Redis PRIVATE url (redis.railway.internal), so it never leaves the
# private network. Drives cache, event bus, workflow engine and locking.
# Railway does not shell-expand $VAR in a start command — if you set a Redis
# password, write it out literally.
REDIS_URL=redis://localhost:6379

# --- Secrets ----------------------------------------------------------------
# Generate real values: openssl rand -base64 32
# The backend refuses to boot in production if these are still "supersecret".
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# HMAC secret for the signed booking-lookup link in the confirmation email.
# A booking holds a phone number, a flight number and a home address, so this is
# the only thing standing between a guessed order id and someone's travel plans.
# Set the SAME value on the storefront (it verifies what this signs).
BOOKING_TOKEN_SECRET=

# --- CORS -------------------------------------------------------------------
# Three separate lists. Adding a storefront origin means updating STORE_CORS
# *and* AUTH_CORS — forgetting AUTH_CORS is the classic one.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# --- Runtime ----------------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
# shared | server | worker. `shared` runs API + worker in one process.
MEDUSA_WORKER_MODE=shared

# --- Fare geometry ----------------------------------------------------------
# Hamad International Airport. EVERY fare in the system keys off this one point,
# because the distance band is resolved as straight-line km from here.
# Verify before trusting: a few hundred metres of error moves band boundaries.
AIRPORT_LAT=25.273056
AIRPORT_LNG=51.608056

# --- Email (SMTP) -----------------------------------------------------------
# Plain SMTP, because it is the one interface every provider offers and
# switching costs nothing but these variables. Leave SMTP_HOST empty and no
# email provider is registered (orders still work, silently, with no mail).
#
# ⚠️ An Outlook mailbox CANNOT be the sender any more, whatever an older note
# says. An app password only works with basic authentication, and Microsoft
# disabled basic auth for personal Outlook accounts on 16 Sept 2024; Microsoft
# 365 tenants lose SMTP AUTH at the end of Dec 2026. Do not spend time on it.
#
# Resend (free, no card, and what the project planned originally):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=resend           SMTP_PASS=<the re_... API key>
#   Verify the domain in Resend first (three DNS records in Cloudflare), or
#   send from onboarding@resend.dev to prove the path before doing that.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Display name and address customers see and reply to.
# Where a customer's reply lands. Mail is sent from the domain through a
# provider, so without this a reply reaches an address nobody reads.
SMTP_REPLY_TO=
SMTP_FROM="Desert Drive <bookings@desertdriverental.com>"
SMTP_FROM_ADDRESS=bookings@desertdriverental.com

# Where the confirmation email's "View your booking" link points.
STOREFRONT_URL=http://localhost:8000

# Shown in the confirmation email. Real values from the owner.
BUSINESS_NAME=Desert Drive Rent a Car
BUSINESS_PHONE=+974 5151 4161
BUSINESS_WHATSAPP_URL=https://wa.me/97451514161
# Registered address and commercial registration number, printed in the email
# footer (Qatar E-Commerce Law No. 16 of 2010 — trader identity on every order
# confirmation). Leave empty until the owner supplies them; nothing fake ships.
BUSINESS_ADDRESS=
BUSINESS_CR=

# --- Payments (SkipCash) ----------------------------------------------------
# Sandbox:    https://skipcashtest.azurewebsites.net
# Production: https://api.skipcash.app
# All from the merchant portal → Sandbox/Production → Credentials. Leave
# SKIPCASH_KEY_SECRET empty and the provider is not registered at all (cash
# only) — useful on a dev machine.
#
# In the portal, set:
#   Webhook URL = <MEDUSA_BACKEND_URL>/hooks/payment/skipcash_skipcash
#   Return URL  = <storefront>/en-qa/payment/return   (the storefront overrides
#                 this per payment; the portal value is only a fallback)
SKIPCASH_BASE_URL=https://skipcashtest.azurewebsites.net
SKIPCASH_CLIENT_ID=
SKIPCASH_KEY_ID=
SKIPCASH_KEY_SECRET=
SKIPCASH_WEBHOOK_KEY=

# --- Escape hatches ---------------------------------------------------------
# `medusa start` forces NODE_ENV=production even locally, which trips the Redis
# guard. Set this ONLY to run a production build on a dev machine.
# NEVER set it on Railway.
# ALLOW_INMEMORY_INFRA=true

# --- Test booking (optional) ------------------------------------------------
# A long random string. Set it and `?test=<that string>` on the results page
# surfaces a 1 QAR vehicle, so a real card can be run through the whole funnel
# -- cart, SkipCash, webhook, confirmation email -- without charging a real
# fare. A test that takes a different path proves nothing about the path that
# takes money, which is why the test vehicle is a real published product.
#
# LEAVE IT UNSET and the test vehicle can never appear, however the request is
# shaped. Being unlisted is not what protects it: a customer offered a 1 QAR
# airport transfer would book it, and be right to. The secret is.
TEST_BOOKING_KEY=

# ---------------------------------------------------------------------------
# Customer image uploads — the picture printed on a meet & greet sign.
#
# Configured against Cloudflare R2, which is S3-compatible. Any other S3
# provider works by changing these values only.
#
# ⚠️ WITHOUT THESE THE UPLOAD ENDPOINT REFUSES, ON PURPOSE. Medusa's default
# file provider writes to the container's disk, and Railway's filesystem is
# ephemeral: the picture would survive until the next deploy and then vanish,
# leaving a booking the customer paid extra for with a sign the driver cannot
# print. A refused upload is recoverable; a silently lost one is discovered at
# 4am in an arrivals hall. The sign's TEXT still works either way.
#
# Use a bucket of its own, NOT the OpenNext page-cache bucket — customer
# uploads should not share a lifecycle with generated cache objects.
# ---------------------------------------------------------------------------
UPLOADS_S3_BUCKET=
UPLOADS_S3_ACCESS_KEY=
UPLOADS_S3_SECRET=
# https://<cloudflare-account-id>.r2.cloudflarestorage.com
UPLOADS_S3_ENDPOINT=
# The PUBLIC base the object is served from: an r2.dev bucket URL or a custom
# domain. It ends up on the order, and the owner opens it to print the sign, so
# it must be publicly readable over https.
UPLOADS_S3_PUBLIC_URL=
# R2 ignores the region; the S3 client insists on one.
UPLOADS_S3_REGION=auto
# Trailing slash required: file-s3 joins it to the filename with nothing between.
UPLOADS_S3_PREFIX=sign-images/

# ---------------------------------------------------------------------------
# Booking notice — the owner's rules (27–28 Sept 2026). Enforced at cart
# completion, so they hold however a cart was made.
# ---------------------------------------------------------------------------
# Below this, a pickup cannot be booked online. MUST match the storefront's
# NEXT_PUBLIC_MIN_LEAD_MINUTES, or the site will offer times the backend refuses.
MIN_LEAD_MINUTES=720
# Below this, each leg costs SURGE_MULTIPLIER fares (a whole number: it is a quantity).
SURGE_WINDOW_MINUTES=720
# 1 = the short-notice fare is off (owner, 30 Sept 2026). 2 brings back 2×.
SURGE_MULTIPLIER=1
