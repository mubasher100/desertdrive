{
  "name": "@dd/storefront",
  "version": "0.1.0",
  "description": "Desert Drive storefront — airport transfer booking funnel",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --turbopack -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@maplibre/maplibre-gl-leaflet": "^0.0.22",
    "@medusajs/icons": "latest",
    "@medusajs/js-sdk": "latest",
    "@medusajs/ui": "latest",
    "@radix-ui/react-accordion": "^1.2.1",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "maplibre-gl": "^4.7.1",
    "next": "^16.4.3",
    "qs": "^6.12.1",
    "react": "19.0.5",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.0.5",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
