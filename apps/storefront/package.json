    "@types/leaflet": "^1.9.12",
    "@types/lodash": "^4.14.195",
    "@types/node": "^20.12.11",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.2",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22"
