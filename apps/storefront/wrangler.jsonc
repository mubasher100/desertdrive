/**
 * Cloudflare Worker configuration for the Desert Drive storefront.
 *
 * Deployed by .github/workflows/deploy-storefront.yml on pushes to main that
 * touch apps/storefront. Locally: `npm run cf:preview`.
 *
 * Ship on workers.dev first. Nothing in the build depends on the custom domain
 * except CORS and canonical URLs, and both are single-variable changes.
 *
 * ⚠️ Secrets do NOT go in this file — it is committed. Set them with
 * `npx wrangler secret put <NAME>`, or in the Cloudflare dashboard.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desertdrive",
  "main": ".open-next/worker.js",

  // Must be >= the @opennextjs/cloudflare release date.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  /**
   * Keep the workers.dev hostname ON, explicitly.
   *
   * ⚠️ Adding a `routes` block turns it OFF unless this says otherwise, and
   * wrangler only warns. On 25 Sept 2026 that took the live site down: the
   * custom domains could not bind — the zone still held the old site's A and
   * CNAME records, which Cloudflare refuses to overwrite — so the deploy
   * failed having already disabled workers.dev, and nothing served at all.
   *
   * The custom domain goes back in only after those records are deleted from
   * the zone, and this line stays either way so the fallback never vanishes
   * again.
   */
  "workers_dev": true,

  /**
   * The live domain.
   *
   * Added only after the zone's old A/CNAME records were deleted — Cloudflare
   * refuses to bind a custom domain over externally managed DNS, and the first
   * attempt at this failed for exactly that reason while having already turned
   * workers.dev off. `workers_dev` above stays true so that cannot recur: if a
   * binding fails, the site keeps serving on the workers.dev hostname.
   *
   * Both hostnames serve; canonical URLs point at the apex.
   */
  "routes": [
    { "pattern": "desertdriverental.com", "custom_domain": true },
    { "pattern": "www.desertdriverental.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  },

  /**
   * Persistent store for prerendered pages and fetch results. Without it every
   * Worker isolate re-renders from scratch.
   *
   * Create it once:  npx wrangler r2 bucket create desertdrive-cache
   */
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "desertdrive-cache"
    }
  ],

  /**
   * Sharded Durable Objects backing the tag cache. This is what makes
   * revalidateTag do anything at all — see open-next.config.ts.
   */
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],

  /**
   * Runtime (server-side) variables. NEXT_PUBLIC_* values are also baked in at
   * build time; MEDUSA_BACKEND_URL is read at request time by server
   * components and actions, so it must exist here too. Secrets
   * (BOOKING_TOKEN_SECRET) are set with `wrangler secret put`, never here.
   */
  "vars": {
    // Qatar is the only region this store serves.
    "NEXT_PUBLIC_DEFAULT_REGION": "qa",
    "MEDUSA_BACKEND_URL": "https://ddbackend-production-e9d1.up.railway.app",
    "NEXT_PUBLIC_BASE_URL": "https://desertdriverental.com"
  }
}
