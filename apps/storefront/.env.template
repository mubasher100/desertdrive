# =============================================================================
# Desert Drive — storefront environment
#
# Copy to `.env.local` for local development. In production these are Cloudflare
# Worker variables. `.env.local` is gitignored; THIS file is committed.
# =============================================================================

# --- Medusa backend ---------------------------------------------------------
# Where the Medusa Store API lives. Deliberately NOT prefixed NEXT_PUBLIC_:
# every call goes through a server component or a server action, so the backend
# origin never needs to be baked into the client bundle.
#
# NEXT_PUBLIC_MEDUSA_BACKEND_URL is still read as a fallback for compatibility,
# but prefer this one.
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Admin → Settings → API Key Management → Publishable API Keys.
# Must be linked to a sales channel. EVERY Store API request is rejected
# without it — this is not optional and the app refuses to build without it.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# The storefront's own public URL. Used for canonical tags, hreflang and the
# absolute URLs in the confirmation email.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# --- Locale -----------------------------------------------------------------
# ISO-2 lowercase. Qatar is the only region this store serves.
NEXT_PUBLIC_DEFAULT_REGION=qa

# --- Google Maps ------------------------------------------------------------
# Places Autocomplete (New), for the destination field ONLY. It never calculates
# a fare — the server resolves the distance band from coordinates.
#
# This key is public by necessity. Restrict it in the Google Cloud console by
# HTTP referrer AND to the Places API only. If server-side Google calls are ever
# added, issue a SEPARATE IP-restricted key rather than reusing this one.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Build ------------------------------------------------------------------
# Set by the `lint` script and by CI so that linting does not fail on a missing
# publishable key. Never set this for a real build.
# SKIP_ENV_VALIDATION=true
