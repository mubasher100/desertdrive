# =============================================================================
# Desert Drive — storefront environment
#
# Copy to `.env.local` for local development. In production these are Cloudflare
# Worker variables. `.env.local` is gitignored; THIS file is committed.
# =============================================================================

# --- Medusa backend ---------------------------------------------------------
# Where the Medusa Store API lives. Deliberately NOT prefixed NEXT_PUBLIC_:
# every call goes through a server component or a server action, so the backend
# origin never needs to be baked into the client bundle.
#
# NEXT_PUBLIC_MEDUSA_BACKEND_URL is still read as a fallback for compatibility,
# but prefer this one.
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Admin → Settings → API Key Management → Publishable API Keys.
# Must be linked to a sales channel. EVERY Store API request is rejected
# without it — this is not optional and the app refuses to build without it.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# The storefront's own public URL. Used for canonical tags, hreflang and the
# absolute URLs in the confirmation email.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# --- Booking lookup ---------------------------------------------------------
# HMAC secret for the signed link on the confirmation page. MUST be the same
# value as the backend's BOOKING_TOKEN_SECRET: the backend signs the link in the
# confirmation email, the storefront verifies it. Server-side only — never
# NEXT_PUBLIC_.
BOOKING_TOKEN_SECRET=

# --- Locale -----------------------------------------------------------------
# ISO-2 lowercase. Qatar is the only region this store serves.
NEXT_PUBLIC_DEFAULT_REGION=qa

# --- Google Maps ------------------------------------------------------------
# Places Autocomplete (New), for the destination field ONLY. It never calculates
# a fare — the server resolves the distance band from coordinates.
#
# This key is public by necessity. Restrict it in the Google Cloud console by
# HTTP referrer AND to the Places API only. If server-side Google calls are ever
# added, issue a SEPARATE IP-restricted key rather than reusing this one.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Build ------------------------------------------------------------------
# Set by the `lint` script and by CI so that linting does not fail on a missing
# publishable key. Never set this for a real build.
# SKIP_ENV_VALIDATION=true

# --- Map tiles (optional) -------------------------------------------------
# The English map falls back to OpenStreetMap's standard tiles, which label
# places in Arabic in Qatar. Set these three to point it at a provider with
# Latin labels. CARTO is NOT an option on a free key: their free tier is
# non-commercial only, and unkeyed tiles are stamped "API KEY REQUIRED".
# The attribution is a condition of every provider's terms -- set it, and set
# it to what that provider requires.
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=abcd

# --- Satellite view (optional) --------------------------------------------
# Adds a "Satellite view" toggle under the map, for a customer finding a
# building that no place database has -- a villa on an unnamed street.
# The toggle is HIDDEN unless both of these are set, because a control that
# does nothing is worse than no control.
#
# There is no free, key-less, high-resolution satellite layer that permits
# commercial use: Esri's World Imagery requires a key AND excludes commercial
# use, and the genuinely open imagery (Sentinel-2, NASA GIBS) is 10 m per
# pixel or coarser, where a villa is a pixel or two. So this needs a free-tier
# key from a provider such as MapTiler.
#
# MapTiler example (free tier, commercial use permitted, key from maptiler.com):
# NEXT_PUBLIC_MAP_SATELLITE_URL=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
# NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=<a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# NEXT_PUBLIC_MAP_SATELLITE_SUBDOMAINS=
